generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum MediaKind {
  IMAGE
  FILE
}

model PlatformMetadata {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_metadata")
}

model ModuleInstallation {
  id          String   @id @default(cuid())
  name        String   @unique
  version     String
  enabled     Boolean  @default(true)
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@map("module_installations")
}

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  passwordHash        String
  firstName           String
  lastName            String
  status              UserStatus               @default(ACTIVE)
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  failedLoginAttempts Int                      @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  roles               UserRole[]
  sessions            Session[]
  auditLogs            AuditLog[]               @relation("AuditActor")
  emailTokens          EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  mediaAssets          MediaAsset[]             @relation("MediaUploader")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  system      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@index([system])
  @@map("roles")
}

model Permission {
  id          String           @id
  description String
  module      String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId      String
  permissionId String
  assignedAt  DateTime   @default(now())
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Session {
  id                  String   @id @default(cuid())
  userId              String
  refreshTokenHash    String   @unique
  familyId            String
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?  @unique
  userAgent           String?
  ipAddress            String?
  lastUsedAt           DateTime @default(now())
  createdAt            DateTime @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy           Session?  @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces             Session[] @relation("SessionReplacement")

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

enum ContentFieldType {
  TEXT
  RICH_TEXT
  NUMBER
  BOOLEAN
  DATE
  JSON
  RELATION
}

enum ContentEntryStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentType {
  id          String            @id @default(cuid())
  name        String
  apiId       String            @unique
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  fields      FieldDefinition[]
  entries     ContentEntry[]

  @@index([name])
  @@map("content_types")
}

model FieldDefinition {
  id            String           @id @default(cuid())
  contentTypeId String
  key           String
  label         String
  type          ContentFieldType
  required      Boolean          @default(false)
  localized     Boolean          @default(false)
  position      Int              @default(0)
  validation    Json?
  settings      Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  contentType   ContentType      @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  @@unique([contentTypeId, key])
  @@index([contentTypeId, position])
  @@map("field_definitions")
}

model ContentEntry {
  id                 String             @id @default(cuid())
  contentTypeId      String
  slug               String
  locale             String             @default("en")
  status             ContentEntryStatus @default(DRAFT)
  data               Json
  seoTitle           String?
  seoDescription     String?
  seoMetadata        Json?
  scheduledPublishAt DateTime?
  publishedAt        DateTime?
  archivedAt         DateTime?
  currentRevision    Int                @default(1)
  createdById        String?
  updatedById        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  contentType        ContentType         @relation(fields: [contentTypeId], references: [id], onDelete: Restrict)
  revisions          ContentRevision[]
  outgoingRelations  EntryRelation[]     @relation("EntryRelationSource")
  incomingRelations  EntryRelation[]     @relation("EntryRelationTarget")

  @@unique([contentTypeId, locale, slug])
  @@index([contentTypeId, status, locale])
  @@index([status, scheduledPublishAt])
  @@index([updatedAt])
  @@map("content_entries")
}

model ContentRevision {
  id                 String             @id @default(cuid())
  entryId            String
  revision           Int
  slug               String
  locale             String
  status             ContentEntryStatus
  data               Json
  seoTitle           String?
  seoDescription     String?
  seoMetadata        Json?
  scheduledPublishAt DateTime?
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdById        String?
  createdAt          DateTime           @default(now())
  entry               ContentEntry       @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, revision])
  @@index([entryId, createdAt])
  @@map("content_revisions")
}

model EntryRelation {
  id            String       @id @default(cuid())
  sourceEntryId String
  targetEntryId String
  fieldKey      String
  createdAt     DateTime     @default(now())
  sourceEntry   ContentEntry @relation("EntryRelationSource", fields: [sourceEntryId], references: [id], onDelete: Cascade)
  targetEntry   ContentEntry @relation("EntryRelationTarget", fields: [targetEntryId], references: [id], onDelete: Cascade)

  @@unique([sourceEntryId, fieldKey, targetEntryId])
  @@index([targetEntryId])
  @@index([sourceEntryId, fieldKey])
  @@map("entry_relations")
}

model MediaAsset {
  id               String    @id @default(cuid())
  originalName     String
  fileName         String
  storageProvider  String
  storageKey       String    @unique
  mimeType         String
  kind             MediaKind
  sizeBytes        Int
  checksumSha256   String
  width            Int?
  height           Int?
  altText          String?
  title            String?
  metadata         Json?
  uploadedByUserId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  uploadedBy       User?     @relation("MediaUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  productMedia     ProductMedia[]

  @@index([kind, createdAt])
  @@index([mimeType])
  @@index([uploadedByUserId, createdAt])
  @@map("media_assets")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  DISABLED
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([name])
  @@map("catalog_brands")
}

model Category {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  parentId    String?
  position    Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]

  @@index([parentId, position])
  @@index([name])
  @@map("catalog_categories")
}

model CatalogAttribute {
  id        String           @id @default(cuid())
  name      String
  slug      String           @unique
  position  Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    AttributeValue[]
  variants  VariantAttributeValue[]

  @@index([position, name])
  @@map("catalog_attributes")
}

model AttributeValue {
  id          String                  @id @default(cuid())
  attributeId String
  value       String
  slug        String
  position    Int                     @default(0)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  attribute   CatalogAttribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    VariantAttributeValue[]

  @@unique([attributeId, slug])
  @@index([attributeId, position])
  @@map("catalog_attribute_values")
}

model Product {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  description String?
  status      ProductStatus     @default(DRAFT)
  brandId     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  brand       Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  categories  ProductCategory[]
  variants    ProductVariant[]
  media       ProductMedia[]

  @@index([status, updatedAt])
  @@index([brandId, status])
  @@index([name])
  @@map("catalog_products")
}

model ProductCategory {
  productId  String
  categoryId String
  position   Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId, productId])
  @@map("catalog_product_categories")
}

model ProductVariant {
  id              String                  @id @default(cuid())
  productId       String
  title           String
  sku             String                  @unique
  status          ProductVariantStatus    @default(ACTIVE)
  position        Int                     @default(0)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValues VariantAttributeValue[]
  commercePrices  CommercePrice[]
  stockLevels     CommerceStockLevel[]
  stockMovements  CommerceStockMovement[]
  cartItems       CommerceCartItem[]
  orderItems      CommerceOrderItem[]

  @@index([productId, position])
  @@index([productId, status])
  @@map("catalog_product_variants")
}

model VariantAttributeValue {
  variantId       String
  attributeId     String
  attributeValueId String
  variant         ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attribute       CatalogAttribute @relation(fields: [attributeId], references: [id], onDelete: Restrict)
  attributeValue  AttributeValue   @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeId])
  @@unique([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("catalog_variant_attribute_values")
}

model ProductMedia {
  productId    String
  mediaAssetId String
  position     Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)

  @@id([productId, mediaAssetId])
  @@index([mediaAssetId])
  @@index([productId, position])
  @@map("catalog_product_media")
}

enum DataSchemaKind {
  COLLECTION
  SINGLE
  COMPONENT
  SYSTEM_EXTENSION
}

enum DataFieldType {
  TEXT
  LONG_TEXT
  RICH_TEXT
  UID
  NUMBER
  BOOLEAN
  DATE
  JSON
  ENUM
  MEDIA
  RELATION
  COMPONENT
  DYNAMIC_ZONE
}

enum DataRecordStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model DataSchema {
  id          String             @id @default(cuid())
  key         String             @unique
  displayName String
  pluralName  String
  description String?
  kind        DataSchemaKind
  publicRead  Boolean            @default(false)
  system      Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  fields      DataField[]
  records     DataRecord[]
  extensions EntityExtension[]

  @@index([kind, displayName])
  @@map("data_schemas")
}

model DataField {
  id                     String        @id @default(cuid())
  schemaId               String
  key                    String
  label                  String
  type                   DataFieldType
  required               Boolean       @default(false)
  repeatable             Boolean       @default(false)
  position               Int           @default(0)
  validation             Json?
  settings               Json?
  relationTargetSchemaId String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  schema                  DataSchema    @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@unique([schemaId, key])
  @@index([schemaId, position])
  @@index([relationTargetSchemaId])
  @@map("data_fields")
}

model DataRecord {
  id          String           @id @default(cuid())
  schemaId    String
  status      DataRecordStatus @default(DRAFT)
  values      Json
  createdById String?
  updatedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  schema      DataSchema       @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@index([schemaId, status, updatedAt])
  @@map("data_records")
}

model EntityExtension {
  id         String     @id @default(cuid())
  schemaId   String
  targetType String
  targetId   String
  values     Json
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  schema     DataSchema @relation(fields: [schemaId], references: [id], onDelete: Cascade)

  @@unique([schemaId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("entity_extensions")
}



enum DiscussionSourceType {
  CONTENT
  PRODUCT
}

enum DiscussionKind {
  COMMENT
  REVIEW
}

enum DiscussionStatus {
  PENDING
  APPROVED
  SPAM
  TRASH
}

model DiscussionSettings {
  id                   String               @id @default(cuid())
  sourceType           DiscussionSourceType
  sourceId             String
  commentsEnabled      Boolean              @default(true)
  reviewsEnabled       Boolean              @default(false)
  ratingEnabled        Boolean              @default(false)
  verifiedPurchaseOnly Boolean              @default(false)
  notifyOnNew          Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([sourceType, sourceId])
  @@map("discussion_settings")
}

model DiscussionEntry {
  id                  String               @id @default(cuid())
  sourceType          DiscussionSourceType
  sourceId            String
  kind                DiscussionKind
  status              DiscussionStatus     @default(PENDING)
  parentId            String?
  authorUserId        String?
  authorName          String
  authorEmail         String
  body                String
  rating              Int?
  verifiedPurchase    Boolean              @default(false)
  moderatedAt         DateTime?
  moderatedByUserId   String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  parent              DiscussionEntry?     @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies             DiscussionEntry[]    @relation("DiscussionReplies")

  @@index([sourceType, sourceId, status, createdAt])
  @@index([kind, status, createdAt])
  @@index([status, createdAt])
  @@index([parentId])
  @@map("discussion_entries")
}


enum CommerceCartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
  EXPIRED
}

enum CommerceCheckoutStatus {
  OPEN
  COMPLETED
  CANCELLED
  EXPIRED
}

enum CommerceOrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
}

enum CommerceStockMovementType {
  ADJUSTMENT
  RECEIVE
  RESERVE
  RELEASE
  SALE
}

model CommercePrice {
  id              String         @id @default(cuid())
  variantId       String
  currency        String
  unitAmount      Int
  compareAtAmount Int?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, currency])
  @@index([currency, active])
  @@map("commerce_prices")
}

model CommerceWarehouse {
  id             String                  @id @default(cuid())
  code           String                  @unique
  name           String
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  stockLevels    CommerceStockLevel[]
  stockMovements CommerceStockMovement[]
  checkouts      CommerceCheckoutSession[]

  @@index([active, name])
  @@map("commerce_warehouses")
}

model CommerceStockLevel {
  id                String            @id @default(cuid())
  warehouseId       String
  variantId         String
  onHand            Int               @default(0)
  reserved          Int               @default(0)
  lowStockThreshold Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  warehouse         CommerceWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  variant           ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, variantId])
  @@index([variantId])
  @@index([warehouseId, updatedAt])
  @@map("commerce_stock_levels")
}

model CommerceStockMovement {
  id            String                    @id @default(cuid())
  warehouseId   String
  variantId     String
  type          CommerceStockMovementType
  onHandDelta   Int
  reservedDelta Int                       @default(0)
  reason        String?
  referenceType String?
  referenceId   String?
  actorUserId   String?
  createdAt     DateTime                  @default(now())
  warehouse     CommerceWarehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  variant       ProductVariant            @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([referenceType, referenceId])
  @@map("commerce_stock_movements")
}

model CommerceCart {
  id              String             @id @default(cuid())
  accessTokenHash String             @unique
  userId          String?
  status          CommerceCartStatus @default(ACTIVE)
  currency        String
  expiresAt       DateTime
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  items           CommerceCartItem[]
  checkout        CommerceCheckoutSession?
  order           CommerceOrder?

  @@index([status, expiresAt])
  @@index([userId, status])
  @@map("commerce_carts")
}

model CommerceCartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      CommerceCart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([cartId, variantId])
  @@index([variantId])
  @@map("commerce_cart_items")
}

model CommerceCheckoutSession {
  id             String                 @id @default(cuid())
  cartId         String                 @unique
  warehouseId    String
  idempotencyKey String                 @unique
  status         CommerceCheckoutStatus @default(OPEN)
  expiresAt      DateTime
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  cart           CommerceCart           @relation(fields: [cartId], references: [id], onDelete: Restrict)
  warehouse      CommerceWarehouse      @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  order          CommerceOrder?

  @@index([status, expiresAt])
  @@map("commerce_checkout_sessions")
}

model CommerceOrder {
  id                String              @id @default(cuid())
  orderNumber       String              @unique
  cartId            String              @unique
  checkoutSessionId String              @unique
  userId            String?
  status            CommerceOrderStatus @default(PENDING_PAYMENT)
  currency          String
  subtotalAmount    Int
  totalAmount       Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  cancelledAt       DateTime?
  cart              CommerceCart        @relation(fields: [cartId], references: [id], onDelete: Restrict)
  checkoutSession   CommerceCheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Restrict)
  items             CommerceOrderItem[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("commerce_orders")
}

model CommerceOrderItem {
  id              String         @id @default(cuid())
  orderId         String
  variantId       String
  sku             String
  title           String
  quantity        Int
  unitAmount      Int
  lineTotalAmount Int
  createdAt       DateTime       @default(now())
  order           CommerceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("commerce_order_items")
}
